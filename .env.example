# Fictional local demo. setup.sh writes actual local credentials to ignored .env.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-long-random-local-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
PGHOST=127.0.0.1
